{
  "name": "ask-zico-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "wrangler dev",
    "dev:docker": "wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.example.jsonc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --config wrangler.jsonc"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
