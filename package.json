{
  "name": "ask-zico",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:contract && npm run test:tools && npm --prefix worker test",
    "test:contract": "node --test --test-isolation=none contract/contract.test.mjs",
    "test:tools": "node --test --test-isolation=none tools/*.test.mjs",
    "lint:contract": "redocly lint contract/openapi.yaml",
    "stub:contract": "node tools/contract-stub.mjs",
    "typecheck": "npm --prefix worker run typecheck",
    "ingest:sample": "node tools/generate-rag-jsonl.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^2.0.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  }
}
